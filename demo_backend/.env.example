# For local server only; NEVER commit .env or DATABASE_URL to GitHub Pages.
# Use the Neon project's existing TEST branch, NOT the production database.
EFHC_DEMO_ENABLED=1
ENV=local
DEMO_DATABASE_URL=postgresql+asyncpg://TEST_USER:TEST_PASSWORD@YOUR_TEST_ENDPOINT.neon.tech/neondb?sslmode=require
DEMO_NEON_HOST=YOUR_TEST_ENDPOINT.neon.tech
DEMO_OPERATOR_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
# Must be an already existing user, and admin if DEMO topup is needed.
DEMO_INITIAL_GLOBAL_ID=0000000002
DEMO_CORS_ORIGINS=https://gly-efhc.github.io,http://localhost:3000
DEMO_COOKIE_SECURE=1
DEMO_ENERGY_SCHEDULER=0
DEMO_ENERGY_PERIOD_SECONDS=60
DEMO_MAX_TOPUP_EFHC=10000.00000000
ALLOW_REAL_FUNDS=false
RUN_EMBEDDED_TON_AGENT=false

# Real TonConnect verification (external TONAPI calls are enabled).
# Create a distinct TEST SECRET_KEY. Keep all keys server-side.
SECRET_KEY=REPLACE_WITH_DISTINCT_TEST_KEY_32_PLUS_CHARACTERS
APP_URL=https://gly-efhc.github.io
FRONTEND_URL=https://gly-efhc.github.io
TON_NETWORK=mainnet
TON_API_BASE_URL=https://tonapi.io
# TON_API_KEY=YOUR_TEST_TON_API_KEY
AUTH_PROVIDER_FLAGS={"ton":true}
# Optional external advertising provider integration config stays available.
# ADS_ENABLED=true
