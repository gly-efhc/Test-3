{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EFHC_GLOBAL_THEME_ROLE_VECTOR_V1",
  "title": "EFHC bounded Global Theme 18-role vector",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "themeId", "themeName", "projectionState", "accentAnchor", "roles", "ownerCycle"],
  "properties": {
    "schema": {"const": "EFHC_GLOBAL_THEME_ROLE_VECTOR_V1"},
    "themeId": {"type": "string", "pattern": "^(01|02|04|05|06|07|08|09|10|11|12|13)$"},
    "themeName": {"type": "string", "minLength": 1},
    "projectionState": {"enum": ["DRAFT_AUDIT", "READY_FOR_GENERATION", "PARTIAL_PROJECTION_AUTHORIZED", "QUALIFIED"]},
    "accentAnchor": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "ownerCycle": {"type": "string", "pattern": "^FRONTEND_ADMIN_CYCLE_[0-9]{4}$"},
    "character": {"type": "string"},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvas","page","chrome","chromeInset","hero","card","inset","active","accent","accentSoft","accentStrong","border","borderStrong","text","textMuted","shadow","glow","focus"],
      "properties": {
        "canvas":{"type":"string","minLength":1},"page":{"type":"string","minLength":1},"chrome":{"type":"string","minLength":1},"chromeInset":{"type":"string","minLength":1},
        "hero":{"type":"string","minLength":1},"card":{"type":"string","minLength":1},"inset":{"type":"string","minLength":1},"active":{"type":"string","minLength":1},
        "accent":{"type":"string","minLength":1},"accentSoft":{"type":"string","minLength":1},"accentStrong":{"type":"string","minLength":1},
        "border":{"type":"string","minLength":1},"borderStrong":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"textMuted":{"type":"string","minLength":1},
        "shadow":{"type":"string","minLength":1},"glow":{"type":"string","minLength":1},"focus":{"type":"string","minLength":1}
      }
    }
  }
}
